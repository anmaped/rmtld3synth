
ifeq (tests,$(firstword $(MAKECMDGOALS)))
  TESTS_ARGS := $(wordlist 2,$(words $(MAKECMDGOALS)),$(MAKECMDGOALS))
  $(eval $(TESTS_ARGS):;@:)
endif

ifeq ($(OS), Windows_NT)
	EXT=.exe
else
	EXT=""
endif

all: compile install

compile: setup
	dune build --profile release @install

setup: version
	echo "Running setup..."

version:
	#echo "let git = \"`git describe --tags` (`git rev-parse HEAD`)\n`uname -m -o` `date +\"%Y-%m-%d %H:%M\"`\"" > src/version.ml

js: version
	opam install js_of_ocaml js_of_ocaml-ppx zarith_stubs_js -y
	dune build --profile js src/rmtld3synth.bc.js

wasm: version
	opam install wasm_of_ocaml-compiler js_of_ocaml js_of_ocaml-ppx js_of_ocaml-lwt zarith_stubs_js -y --confirm-level unsafe-yes
	dune build --profile js src/rmtld3synth.bc.wasm.js

server:
	opam install dream lwt jsonschema -y --confirm-level unsafe-yes
	dune build --profile release @install

tests:
	dune runtest -p rmtld3synth

clean-tests:
	rm _build_tests -r -f

install:
	@echo "OS: ${OS}"
	@echo "Installing rmtld3synth to ${PREFIX}/bin; dune may modify the default path."
	dune install

uninstall:
	dune uninstall

clean:
	dune clean
	rm -f *.byte *.native
	rm -f src/interface/z3solver_.ml src/interface/mathkernel_call_.ml src/js/helper_.ml version.ml
