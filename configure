#!/bin/bash

prefix=/usr/local
debugsym=true
z3_solver=true

for arg in "$@"; do
    case "$arg" in
    --prefix=*)
        prefix=$(echo $arg | sed 's/--prefix=//')
        ;;

    --enable-debug)
        debugsym=true
        ;;
    --disable-debug)
        debugsym=false
        ;;

    --without-z3-solver)
        z3_solver=false
        ;;

    --help)
        echo 'usage: ./configure [options]'
        echo 'options:'
        echo '  --prefix=<path>: installation prefix'
        echo '  --enable-debug: include debug symbols'
        echo '  --disable-debug: do not include debug symbols'
        echo 'all invalid options are silently ignored'
        exit 0
        ;;
    esac
done

if [[ "$OSTYPE" == "darwin"* ]]; then
    # Mac OSX sed
    SED="sed -i ''"
else
    # GNU sed
    SED="sed -i''"
fi

# checks if z3 solver is available
chmod 755 scripts/check_z3.sh
. scripts/check_z3.sh

echo 'generating makefile ...'
echo "PREFIX = $prefix" >Makefile
if $debugsym; then
    echo 'dbg = -g' >>Makefile
fi
cat Makefile.in >>Makefile

if [ -n "$Z3_VERSION" ] && [ "x$z3_solver" == "xtrue" ]; then
    echo "Z3 Version Found: $Z3_VERSION"

    if $(vercmp "$Z3_VERSION" "4.7.1" "<="); then
        echo "Z3 Version is not compatible. Version > 4.7.1 required."
        exit 1
    fi
 
else
    echo "Z3 Version Not Found. Z3 Solver Interface will be disabled."
fi

echo 'configuration complete, type make to build.'
