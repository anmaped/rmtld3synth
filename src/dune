
(executable
  (name            rmtld3synth)
  (public_name     rmtld3synth)
  (libraries       rmtld3synth.synthesis rmtld3synth.options)
  (modules         Rmtld3synth Version)
  (flags           (-cclib -lstdc++) )
  (modes           byte exe js wasm)


  (js_of_ocaml
    (flags
     --disable=genprim
     --debug-info
     +base/runtime.js
     +zarith_stubs_js/runtime.js
     +zarith_stubs_js/biginteger.js)
  )
)

(library
  (name            rmtld3)
  (public_name     rmtld3synth.rmtld3)
  (libraries       bigarray-compat sexplib ppx_sexp_conv yojson ppx_yojson_conv)
  (modules         Rmtld3 Rmtld3_eval)
  (preprocess      (pps ppx_sexp_conv ppx_yojson_conv))
)

(library
  (name            rmtld3_extension)
  (public_name     rmtld3synth.rmtld3.extension)
  (libraries       rmtld3synth.rmtld3 sexplib ppx_sexp_conv)
  (modules         Rmtld3_extension)
  (preprocess      (pps ppx_sexp_conv))
)

(library
  (name            options)
  (public_name     rmtld3synth.options)
  (libraries       rmtld3synth.helper rmtld3synth.interface rmtld3synth.interface.dsl sexplib ppx_sexp_conv)
  (modules         Options)
  (preprocess      (pps ppx_sexp_conv))
)

(library
  (name            helper)
  (public_name     rmtld3synth.helper)
  (libraries       rmtld3synth.rmtld3
    (select helper_.ml from
      ( rmtld3synth.js -> helper_.js.ml)
      ( unix !rmtld3synth.js -> helper_.nojs.ml)
      ( -> helper_.nojs.ml)
    )
    sexplib ppx_sexp_conv)
  (modules         Helper Helper_)
  (preprocess      (pps ppx_sexp_conv))
)
