###############################
# Build stage
###############################
FROM ocaml/opam:debian-12-ocaml-5.1 AS build

USER opam
WORKDIR /home/opam/app

# System dependencies typically needed by Dream + TLS + common OCaml deps
RUN sudo apt-get update && sudo apt-get install -y \
    m4 pkg-config libssl-dev libffi-dev libgmp-dev python3

# Copy project
COPY --chown=opam:opam . .

# Install OCaml dependencies
RUN opam update
RUN opam install . --deps-only -y
RUN opam install dune -y

# Build optimized executable
RUN eval $(opam env) && ./configure && dune build --profile release src/server/server.exe

# Copy the executable to a predictable location
RUN cp _build/default/src/server/server.exe /home/opam/app/server

# copy libz3.so to the build output
RUN cp $(opam var lib)/stublibs/libz3.so /home/opam/app/libz3.so

###############################
# Runtime stage
###############################
FROM debian:12-slim AS runner

# Install minimal needed runtime libs
RUN apt-get update && apt-get install -y libssl3 && apt-get clean

WORKDIR /app

# Bring in the OCaml-built server
COPY --from=build /home/opam/app/server /app/server

EXPOSE 8001

CMD ["./server"]
