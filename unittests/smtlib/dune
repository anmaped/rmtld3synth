(rule
  (with-outputs-to test01.out
  (with-accepted-exit-codes 0
    (run bash -c "%{exe:../../src/rmtld3synth.exe} --synth-smtlibv2 --input-dsl \"$(cat %{dep:test01.in})\" ")
)))

(rule
  (alias runtest)
  (action (diff test01.exp test01.out))
)

(rule
  (with-outputs-to test02.out
